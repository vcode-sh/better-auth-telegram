{
  "name": "better-auth-telegram",
  "version": "3.0.0",
  "description": "Telegram authentication plugin for Better Auth",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "telegram",
    "telegram-login",
    "telegram-mini-apps",
    "authentication",
    "oidc",
    "oauth",
    "plugin",
    "typescript"
  ],
  "homepage": "https://github.com/vcode-sh/better-auth-telegram#readme",
  "bugs": {
    "url": "https://github.com/vcode-sh/better-auth-telegram/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcode-sh/better-auth-telegram.git"
  },
  "license": "MIT",
  "author": "Vibe Code <hello@vcode.sh> (https://vcode.sh)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepublishOnly": "npm run lint && npm run type-check && npm test && npm run build && npm run test:package",
    "test": "vitest run",
    "test:adapters": "vitest run --config vitest.adapters.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/check-package.mjs",
    "test:types": "tsc -p test-d && tsc -p test-d/tsconfig.node16.json",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css}": [
      "ultracite fix"
    ]
  },
  "dependencies": {
    "jose": "^6.2.14"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@better-auth/core": "1.7.14",
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/kysely-adapter": "1.7.14",
    "@better-auth/mongo-adapter": "1.7.14",
    "@better-auth/prisma-adapter": "1.7.14",
    "@biomejs/biome": "2.6.4",
    "@prisma/client": "6.19.3",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "auth": "1.7.14",
    "better-auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "happy-dom": "21.0.4",
    "lint-staged": "17.6.0",
    "mongodb": "7.7.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "prisma": "6.19.3",
    "publint": "0.3.25",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@better-auth/core": ">=1.7.12 <1.8.0",
    "better-auth": ">=1.7.12 <1.8.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
