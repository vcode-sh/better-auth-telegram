# Database - SQLite for simplicity
DATABASE_URL="file:./dev.db"

# Better Auth
BETTER_AUTH_SECRET="your-super-secret-key-change-this-in-production"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated list of trusted origins (required when using ngrok)
# BETTER_AUTH_TRUSTED_ORIGINS="https://your-ngrok-url.ngrok-free.app"

# Telegram Bot Configuration
# Get these from @BotFather on Telegram:
# 1. Send /newbot to @BotFather
# 2. Save the token and username
# 3. Register the public HTTPS domain with /setdomain (Login Widget only)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_BOT_USERNAME="your_bot_username"

# Telegram OIDC Configuration (a separate bot switched to OpenID Connect)
# In @BotFather mini app: your bot > Login Widget
# Redirect URIs: https://<your domain>/api/auth/callback/telegram-oidc
# /setdomain does not configure OIDC; see ../docs/telegram-bot-setup.md
TELEGRAM_OIDC_CLIENT_ID="your_oidc_bot_id"
TELEGRAM_OIDC_CLIENT_SECRET="your_oidc_client_secret"

# Next.js - set to your ngrok URL for external access
NEXT_PUBLIC_APP_URL="http://localhost:3000"
